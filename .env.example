# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com os valores reais) para o GitHub.

# Connection string do Neon (Console da Neon → seu projeto → "Connect")
DATABASE_URL=postgresql://usuario:senha@ep-xxxxxxxx.neon.tech/neondb?sslmode=require

# String aleatória longa, só sua, usada para assinar o cookie de sessão.
# Gere uma, por exemplo, com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande

NODE_ENV=production
