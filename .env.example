# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com os valores reais) para o GitHub.

# Connection string do Neon (Console da Neon → seu projeto → "Connect")
DATABASE_URL=postgresql://usuario:senha@ep-xxxxxxxx.neon.tech/neondb?sslmode=require

# String aleatória longa, só sua, usada para assinar o cookie de sessão.
# Gere uma, por exemplo, com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande

# Chave gratuita do Google AI Studio (aistudio.google.com/apikey), usada
# pela importação do Baú por imagem (IA de visão). Sem custo, sem cartão
# de crédito. Se não configurar, o site funciona normalmente — só o botão
# "Importar por imagem" do Baú fica indisponível.
GEMINI_API_KEY=

# Opcional: troca o modelo do Gemini usado na importação por imagem.
# Padrão: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

NODE_ENV=production
